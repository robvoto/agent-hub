OPENAI_API_KEY=
HUB_BOT_TOKEN=
HUB_ALLOWED_CHAT_IDS=
# Required: set this to an approved model present in config/llm_costs.json.
HUB_MODEL=
# Optional provider-neutral override. gpt-6-luna tool calling on the current
# Chat Completions path requires none.
HUB_REASONING_EFFORT=
# Optional bounded independent handoff reviewer settings. The reviewer model
# defaults to HUB_MODEL and never receives tools or conversation history.
HUB_HANDOFF_REVIEW_MODEL=
# Explicit reviewer-only reasoning setting; it does not inherit HUB_REASONING_EFFORT.
HUB_HANDOFF_REVIEW_REASONING_EFFORT=none
HUB_HANDOFF_REVIEW_TIMEOUT_SECONDS=30
HUB_HANDOFF_REVIEW_MAX_TOKENS=1200

# Local Agent Hub only. Enable only where the governed stdio Human MCP bridge exists.
HUB_HUMAN_MCP_ENABLED=false
