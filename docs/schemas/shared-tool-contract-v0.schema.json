{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-tool-contract-v0.schema.json",
  "title": "Shared Agent Tool Contract — DRAFT, NOT APPROVED",
  "description": "Proposal only. No auth derives from a model-authored request. Broker must bind authenticated principal, account scopes, approvals and tool risk from trusted runtime state.",
  "oneOf": [
    {
      "$ref": "#/$defs/capability"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool.capability"
        },
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "operation_class": {
          "enum": [
            "read",
            "draft",
            "write",
            "send",
            "sign"
          ]
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "input_schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_required": {
          "type": "boolean"
        },
        "approval_required": {
          "type": "boolean"
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "capability_id",
        "version",
        "operation_class",
        "required_scopes",
        "input_schema_ref",
        "output_schema_ref",
        "idempotency_required",
        "approval_required"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "description": "Envelope carries untrusted operation inputs only. Identity and authority are bound by broker from authenticated transport and policy; account_ref and approval_ref are hints for server-side resolution and verification, not grants.",
      "properties": {
        "kind": {
          "const": "tool.request"
        },
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "account_ref": {
          "type": "string",
          "maxLength": 180,
          "minLength": 1
        },
        "approval_ref": {
          "type": "string",
          "maxLength": 250,
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "maxLength": 180,
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "description": "Must be validated against the trusted, versioned capability input schema; never accept provider secrets as tool inputs."
        }
      },
      "required": [
        "kind",
        "capability_id",
        "version",
        "request_id",
        "inputs"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool.result"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "audit_id": {
          "type": "string",
          "maxLength": 180,
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "approval_required",
            "denied",
            "failed",
            "unknown_outcome",
            "unavailable",
            "cancelled"
          ]
        },
        "output": {
          "type": "object",
          "description": "Tool-specific schema-validated output; never provider tokens or sensitive raw artifacts."
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 100
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "kind",
        "request_id",
        "audit_id",
        "status"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHORIZED",
            "SCOPE_DENIED",
            "APPROVAL_REQUIRED",
            "APPROVAL_EXPIRED",
            "INVALID_INPUT",
            "CONFLICT",
            "RATE_LIMITED",
            "PROVIDER_UNAVAILABLE",
            "UNKNOWN_OUTCOME",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 300,
          "description": "Sanitized human-readable status; must not include credentials or confidential payload."
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
